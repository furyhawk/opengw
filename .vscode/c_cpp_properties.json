{
  "version": 4,
  "configurations": [
    {
      "name": "macOS (SDL3 / Homebrew)",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/assets",
        "/opt/homebrew/include",
        "/opt/homebrew/include/SDL3",
        "/Library/Frameworks/SDL3.framework/Headers"
      ],
      "defines": [
        "SDL_MAIN_HANDLED"
      ],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "macos-clang-arm64"
    }
  ]
}
