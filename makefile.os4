LIBS = -lSDL3
OWN_PATHS = -Isrc
HEADERS = $(OWN_PATHS) -I/SDK/local/newlib/include
DEFINES =
CFLAGS = -std=c++20 -Wall -Wextra -O3 -gstabs
NAME = trigwars
# bgfx builds add -DUSE_BGFX_RENDERER, which changes the compiled result, so
# they get their own object tree (see the canonical Makefile).
USE_BGFX ?= 0
ifeq ($(USE_BGFX),1)
OBJDIR = obj-bgfx
else
OBJDIR = obj
endif

ifeq ($(USE_BGFX),1)
BGFX_CFLAGS ?=
BGFX_LIBS ?=
ifeq ($(strip $(BGFX_CFLAGS) $(BGFX_LIBS)),)
$(error USE_BGFX=1 requested, set BGFX_CFLAGS and BGFX_LIBS for your bgfx install)
endif
DEFINES += -DUSE_BGFX_RENDERER $(BGFX_CFLAGS)
LIBS += $(BGFX_LIBS)
endif

SRC_DIRS = core entities render audio ui math vendor
SRC_FILES = $(foreach d,$(SRC_DIRS),$(wildcard src/$(d)/*.cpp))
OBJ_FILES = $(SRC_FILES:.cpp=.o)

OBJS = $(addprefix $(OBJDIR)/, $(OBJ_FILES))
DEPS = $(OBJS:.o=.d)

COMPILER = g++

all: $(NAME)
	#$(NAME)

# dependencies
$(OBJDIR)/%.d : %.cpp | $(OBJDIR)
	@mkdir -p $(dir $@)
	$(COMPILER) -MM -MP -MT $(@:.d=.o) -o $@ $< $(CFLAGS) $(DEFINES) $(HEADERS)

# compiling
$(OBJDIR)/%.o : %.cpp | $(OBJDIR)
	@mkdir -p $(dir $@)
	$(COMPILER) -o $@ -c $< $(CFLAGS) $(DEFINES) $(HEADERS)

clean:
	rm -rf obj obj-bgfx

$(NAME): $(OBJS)
	$(COMPILER) -o $@ $(OBJS) $(LIBS) -athread=native

$(OBJDIR):
	mkdir -p $@

# Load .d files
ifneq ($(MAKECMDGOALS),clean)
-include $(DEPS)
endif
